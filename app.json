{
  "expo": {
    "name": "QuickX Learn",
    "slug": "QuickXLearn",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "quickxlearn",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.quickxlearn.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {}
    },
    "android": {
      "package": "com.quickxlearn.app",
      "adaptiveIcon": {
        "backgroundColor": "#05080f",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 150,
          "resizeMode": "contain",
          "backgroundColor": "#05080f"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow QuickX Learn to use your photos so you can add a profile picture or share a chart in the community.",
          "cameraPermission": "Allow QuickX Learn to use the camera to take a profile picture."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#2f6bff"
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-web-browser",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "backgroundColor": "#05080f",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "eb796df4-88b8-42a2-ad4b-10c4e307b416"
      }
    },
    "owner": "clemss"
  }
}
